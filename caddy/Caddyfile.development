https://localhost {
	encode zstd gzip

	handle /health {
		respond "ok" 200
	}

	handle_path /api/* {
		# Telegraf ingest goes to the Go service; everything else, including
		# the GET /metrics/... routes the dashboard uses, stays on Flask.
		@telegraf_ingest {
			method POST
			path /metrics /metrics/
		}
		handle @telegraf_ingest {
			reverse_proxy metrics:9000
		}

		handle {
			reverse_proxy backend:7000
		}
	}

	handle_path /alertmanager/* {
		reverse_proxy alertmanager:9093
	}

	handle {
		root * /dist
		try_files {path} /index.html
		file_server
	}

	tls internal
}
