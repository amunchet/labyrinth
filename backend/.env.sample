APIURL=API_URL
AUTH0DOMAIN=AUTH0_DOMAIN
TELEGRAF_KEY=TELEGRAF_KEY

# Database backend - see backend/db/ and MONGO_MIGRATION.md.
# "postgres" (default if unset) or "mongo" (fallback/rollback path).
DB_BACKEND=postgres

# Postgres/TimescaleDB - only used when DB_BACKEND=postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=labyrinth
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=labyrinth

# Per-process connection pool bounds (Postgres backend only). Demand is
# POSTGRES_POOL_MAX per *process*: 8 gunicorn workers + the mcp service + up
# to ~4 cron jobs overlapping on the same minute. Budget that against the
# server's max_connections (POSTGRES_MAX_CONNECTIONS in the root .env) or
# Postgres starts refusing clients. See "Connection budget" in
# MONGO_MIGRATION.md before raising these.
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=2

# Redis -> Postgres metrics transfer (cron/bulk_write.sh, once a minute).
# Only one transfer runs at a time; when one overruns the minute, the next
# tick waits up to BULK_INSERT_LOCK_WAIT_SECONDS for it rather than running
# concurrently. The TTL bounds how long a crashed run holds the lock.
BULK_INSERT_LOCK_WAIT_SECONDS=240
BULK_INSERT_LOCK_TTL_SECONDS=120

# Metrics retention (Postgres backend only, both optional - unset means
# "keep forever", matching MongoDB's historical unbounded-growth behavior):
#   METRICS_RAW_RETENTION_DAYS - after this many days, raw `metrics` rows are
#     compacted into daily aggregates by cron/compact_metrics.sh and removed.
#   METRICS_DAILY_RETENTION_DAYS - if set, also caps how long compacted daily
#     aggregates are kept.
METRICS_RAW_RETENTION_DAYS=30
METRICS_DAILY_RETENTION_DAYS=

# Local retention for cron/backup_db.sh's pg_dump files under /backups
# (separate from whatever your offsite system does with them).
BACKUP_RETENTION_DAYS=14

# MongoDB - only used when DB_BACKEND=mongo.
MONGO_USERNAME=root
MONGO_PASSWORD=CHANGE_ME
MONGO_HOST=mongo
