APIURL=API_URL
AUTH0DOMAIN=AUTH0_DOMAIN
TELEGRAF_KEY=TELEGRAF_KEY

# Database backend - see backend/db/ and MONGO_MIGRATION.md.
# "postgres" (default if unset) or "mongo" (fallback/rollback path).
DB_BACKEND=postgres

# Postgres/TimescaleDB - only used when DB_BACKEND=postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=labyrinth
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=labyrinth

# Metrics retention (Postgres backend only, both optional - unset means
# "keep forever", matching MongoDB's historical unbounded-growth behavior):
#   METRICS_RAW_RETENTION_DAYS - after this many days, raw `metrics` rows are
#     compacted into daily aggregates by cron/compact_metrics.sh and removed.
#   METRICS_DAILY_RETENTION_DAYS - if set, also caps how long compacted daily
#     aggregates are kept.
METRICS_RAW_RETENTION_DAYS=30
METRICS_DAILY_RETENTION_DAYS=

# Local retention for cron/backup_db.sh's pg_dump files under /backups
# (separate from whatever your offsite system does with them).
BACKUP_RETENTION_DAYS=14

# MongoDB - only used when DB_BACKEND=mongo.
MONGO_USERNAME=root
MONGO_PASSWORD=CHANGE_ME
MONGO_HOST=mongo
