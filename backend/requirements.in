# Edit this list, not requirements.txt: that is the hash-locked file the backend
# and cron images install (pip --require-hashes). Regenerate it from this
# directory with the Python those images run (ubuntu:latest, now 26.04: 3.14):
#   docker run --rm -v "$PWD:/w" -w /w python:3.14-slim sh -c "pip install pip-tools && pip-compile --generate-hashes --allow-unsafe --strip-extras -o requirements.txt requirements.in"

flask==2.*
flask-cors
flask-socketio
gunicorn
gevent
python-dotenv
python-jose
pymongo[srv]>=4.6,<5
