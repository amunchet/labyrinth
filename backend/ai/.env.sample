OPENAI_KEY=XXXXXXXXXXXXX
OPENAI_CHAT_MODEL=gpt-5-mini

# AI chat (experimental) - additional LLM providers. Only providers with the
# relevant key/host set below will show up as selectable in the chat UI.
ANTHROPIC_API_KEY=XXXXXXXXXXXXX
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_CHAT_SESSION_TTL_SECONDS=86400

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM=alerts@yourdomain.com
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_TO=someone@gmail.com