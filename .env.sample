# Root-level .env - read by `docker compose` itself for ${VAR} substitution
# in docker-compose-production.yml (distinct from backend/.env.sample, which
# is loaded inside the backend/cron containers by python-dotenv).
#
# Copy to `.env` in this same directory and fill in real values before
# running docker-compose-production.yml.

TZ=UTC

# Postgres/TimescaleDB superuser credentials for the self-hosted `postgres`
# service - see backend/db/ and MONGO_MIGRATION.md. POSTGRES_USER/DB default
# to "labyrinth" if unset; POSTGRES_PASSWORD has no default and must be set.
POSTGRES_USER=labyrinth
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=labyrinth

# Server-side connection ceiling for the `postgres` service. Pinned
# explicitly because the timescale/timescaledb image runs timescaledb-tune on
# first start, which sets max_connections=50 - low enough that the stack can
# exhaust it and start answering "FATAL: sorry, too many clients already".
# Budget it against POSTGRES_POOL_MAX (backend/.env.sample); if you raise
# gunicorn's --workers, raise this to match. See MONGO_MIGRATION.md.
POSTGRES_MAX_CONNECTIONS=100

# Pre-shared secret for the MCP server (backend/ai/mcp/), passed through to the
# `mcp` service in docker-compose-production.yml. It bypasses Auth0, so it has
# no default and refuses to start without a key - generate one with
# `openssl rand -hex 32`. Leave this unset to keep it in backend/.env instead.
MCP_KEY=CHANGE_ME
