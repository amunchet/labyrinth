# Root-level .env - read by `docker compose` itself for ${VAR} substitution
# in docker-compose-production.yml (distinct from backend/.env.sample, which
# is loaded inside the backend/cron containers by python-dotenv).
#
# Copy to `.env` in this same directory and fill in real values before
# running docker-compose-production.yml.

TZ=UTC

# Postgres/TimescaleDB superuser credentials for the self-hosted `postgres`
# service - see backend/db/ and MONGO_MIGRATION.md. POSTGRES_USER/DB default
# to "labyrinth" if unset; POSTGRES_PASSWORD has no default and must be set.
POSTGRES_USER=labyrinth
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=labyrinth
